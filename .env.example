# HCLS AI Factory — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored (.gitignore:76-77,102) and MUST stay that way;
# only this template is tracked.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Without these four, `docker compose -f docker-compose.dgx-spark.yml config` fails outright and
# nothing starts. There was no template in the repo before 2026-08-15, so a fresh clone could not
# be brought up without reading the compose file to discover what was required.

# --- Claude API (RAG/chat, agent reasoning) ---------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- MinIO object store backing Milvus --------------------------------------
# Any values you like, but they must be consistent across restarts or Milvus loses its data.
# Do NOT use minioadmin/minioadmin.
HCLS_MINIO_USER=
HCLS_MINIO_PASSWORD=

# --- Grafana admin ----------------------------------------------------------
GRAFANA_PASSWORD=

# --- Tuberous Sclerosis disease program -------------------------------------
# The TSC RAG store defaults to IN-MEMORY: its corpus is rebuilt from src/rag/corpus.py
# (SEED_CORPUS) at startup, so it is never stale — but it is also invisible to
# `scripts/check_corpus.py`, to monitoring, and to anything that inspects Milvus, and it
# cannot grow beyond what is hard-coded. TSC_USE_MILVUS=1 puts it in the shared vector DB
# alongside every other subject. `TSC_USE_MILVUS: "1"` is already set in the program's
# docker-compose.yml, but the supervisor launches it with uvicorn, so that never applies.
#
# Re-ingest is idempotent as of 2026-09-16 (deterministic content pk + upsert); before that
# each run of scripts/load_rag.py appended the whole corpus again.
TSC_USE_MILVUS=
TSC_USE_REAL_EMBEDDINGS=

# --- Streamlit UI access (SEC, 2026-09-16) ----------------------------------
# The five Streamlit UIs now bind to 127.0.0.1 and are NOT reachable from the network.
# LAN access goes through Caddy with basic auth on 8721-8725 (TLS, internal CA):
#
#   8721 RAG Chat (:8501)      8722 Drug Discovery (:8505)   8723 Discovery Portal (:8510)
#   8724 Biomarker UI (:8528)  8725 Neurology UI (:8535)
#
# Credentials are NOT env vars — Caddy reads caddy/ui-auth.conf (gitignored, mode 600).
# Generate it with the recipe in caddy/ui-auth.conf.example; the plaintext lands in
# .caddy-ui-password (also gitignored, mode 600).
