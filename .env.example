# HCLS AI Factory — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored (.gitignore:76-77,102) and MUST stay that way;
# only this template is tracked.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Without these four, `docker compose -f docker-compose.dgx-spark.yml config` fails outright and
# nothing starts. There was no template in the repo before 2026-08-15, so a fresh clone could not
# be brought up without reading the compose file to discover what was required.

# --- Claude API (RAG/chat, agent reasoning) ---------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- MinIO object store backing Milvus --------------------------------------
# Any values you like, but they must be consistent across restarts or Milvus loses its data.
# Do NOT use minioadmin/minioadmin.
HCLS_MINIO_USER=
HCLS_MINIO_PASSWORD=

# --- Grafana admin ----------------------------------------------------------
GRAFANA_PASSWORD=
