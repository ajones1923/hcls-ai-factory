# =============================================================================
# Precision Oncology Engine (agent app) — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Required: Anthropic API key for Claude LLM
ONCO_ANTHROPIC_API_KEY=

# API server (defaults shown)
ONCO_API_HOST=0.0.0.0
ONCO_API_BASE_URL=http://localhost:8526

# Milvus connection (defaults shown)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Path to the shared platform library (only needed if hcls_common is not pip-installed)
# HCLS_LIB_PATH=../../../../lib

# Optional: URLs of sibling engines/agents for cross-modal joins
# IMAGING_AGENT_URL=http://localhost:8525
# BIOMARKER_AGENT_URL=http://localhost:8528
# CART_AGENT_URL=http://localhost:8521
# CARDIOLOGY_AGENT_URL=http://localhost:8536
