# =============================================================================
# Genomic Foundation Engine — Web Portal (Flask) — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# API key required to call the portal's endpoints (set a strong value).
# Auth is ALWAYS enforced: leave this empty and the portal generates an ephemeral key at
# startup, writes it to PORTAL_API_KEY_FILE (mode 0600) and names that file in its log.
PORTAL_API_KEY=

# Where an ephemeral key is written when PORTAL_API_KEY is empty.
# Default: $XDG_RUNTIME_DIR/hcls-genomics-portal.key, else the same name under the temp dir.
PORTAL_API_KEY_FILE=

# Flask server (defaults shown)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0

# Comma-separated allowed CORS origins.
# Default: http://localhost:5000,http://127.0.0.1:5000 — do NOT set this to '*'.
CORS_ORIGINS=

# Container images PB_IMG may be set to via /api/config (comma-separated).
# Empty = the portal's built-in pinned Parabricks set.
PORTAL_ALLOWED_IMAGES=

# Directory the path-valued config keys (GP, IN, REF, OUT, LOG) must stay inside.
# Empty = the genomic-foundation engine directory.
PORTAL_CONFIG_PATH_ROOT=

# Upload size ceiling in bytes (default 107374182400 = 100 GB)
PORTAL_MAX_UPLOAD_BYTES=

# Set to 1 only when running inside the docker compose network
ALLOW_DOCKER_NETWORK=0
