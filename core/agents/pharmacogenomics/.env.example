# =============================================================================
# Pharmacogenomics Intelligence Agent — Environment Variables
# HCLS AI Factory / ai_agent_adds / pharmacogenomics_intelligence_agent
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Author: Adam Jones
# Date:   March 2026
# =============================================================================

# ── LLM API Key (required) ──
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Milvus Connection ──
PGX_MILVUS_HOST=localhost
PGX_MILVUS_PORT=19530

# ── Service Ports ──
PGX_STREAMLIT_PORT=8507
PGX_API_PORT=8107

# ── Embedding Model ──
PGX_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── LLM Model ──
PGX_LLM_MODEL=claude-sonnet-4-6

# ── NCBI / PubMed (optional — increases rate limit from 3 to 10 req/s) ──
# PGX_NCBI_API_KEY=

# ── RAG Search ──
PGX_TOP_K_PER_COLLECTION=5
PGX_SCORE_THRESHOLD=0.4

# ── Ingest Scheduler ──
PGX_INGEST_ENABLED=false
PGX_INGEST_SCHEDULE_HOURS=168

# ── Monitoring ──
PGX_METRICS_ENABLED=true

# ── CORS Origins ──
PGX_CORS_ORIGINS=http://localhost:8080,http://localhost:8107,http://localhost:8507
