# =============================================================================
# CAR-T Intelligence Agent — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Required: Anthropic API key for Claude LLM
CART_ANTHROPIC_API_KEY=

# Optional: NCBI/PubMed API key (higher rate limits for literature search)
CART_NCBI_API_KEY=

# Milvus connection (defaults shown)
CART_MILVUS_HOST=localhost
CART_MILVUS_PORT=19530

# API server (defaults shown)
CART_API_HOST=0.0.0.0
CART_API_PORT=8521

# Streamlit UI port (default shown)
CART_STREAMLIT_PORT=8520

# Optional: URLs of sibling agents/engines for cross-collection evidence
# BIOMARKER_AGENT_URL=http://localhost:8528
# CARDIOLOGY_AGENT_URL=http://localhost:8536
