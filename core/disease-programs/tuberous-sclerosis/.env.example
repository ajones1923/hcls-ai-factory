# TSC Intelligence Engine — environment (copy to .env). All optional; the engine
# runs with none of these set (SQLite event store + offline model stubs).
# TSC_ANTHROPIC_API_KEY=sk-ant-...        # enable real Claude tier calls
# TSC_OFFLINE=1                           # force deterministic stubs even with a key
# TSC_POSTGRES_DSN=postgresql://...       # use Postgres event store instead of SQLite
# TSC_MILVUS_URI=http://localhost:19530
# TSC_REDIS_URL=redis://localhost:6379/0
# TSC_OLLAMA_URL=http://localhost:11434
